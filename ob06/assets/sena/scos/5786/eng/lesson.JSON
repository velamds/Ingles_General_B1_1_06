le06ob06re2img03.jpg"}], "audiosrc": "engenn6le06ob06re2aud01", "coverimg": "engenn6le06ob06re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}