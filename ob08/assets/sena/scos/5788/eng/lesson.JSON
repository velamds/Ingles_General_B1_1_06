ctions", "contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words.</span><span class=\"bullet\">Use capital letters where necessary.</span>", "type": "text"}, {"content": "engenn6le06ob08re6aud02", "type": "audio"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "Writing", "type": "skill"}]}], "type": "TYP", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le06ob08re2img02.jpg"}, {"text": "It's tricky to get a job in the theater industry! Have you tried?\nMany dream about being the most famous actor on Broadway.", "id": 1, "time": "100", "image": "engenn6le06ob08re2img02.jpg"}, {"text": "Unfortunately, competition is fierce for every position. Some say it is the one of the toughest industries to crack. Industry experts have often said that employers are rigorous about specific experience. They have recommended a number of things to consider if you are thinking about this kind of career. Here's some of the best advice I have read on how to quickly snag your dream acting job.", "id": 2, "time": "8000", "image": "engenn6le06ob08re2img03.jpg"}, {"text": "<ol><li>Act professionally and talk to people at events, and ask everyone for advice.  Don't be shy!</li>\n<li>See and read a lot of different plays.  This broadens your understanding of the industry and indicates enthusiasm.</li>\n<li>Work diligently or volunteer selflessly at the Front of House. This is a great way to meet others in the industry.</li>\n<li>Get involved in any productions or events in your area. Many of the most well-known faces in the industry started in neighborhood productions.</li></ol>", "id": 3, "time": "33000", "image": "engenn6le06ob08re2img01.jpg"}], "audiosrc": "engenn6le06ob08re2aud01", "coverimg": "engenn6le06ob08re2img02.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": {"images": [{"text": "The Present Perfect Tense <br> <br>Use the Present Perfect to talk about:</li><li>a finished action connected to the present <br>OR</li><li>a finished action not necessarily connected to the present.", "id": 0, "time": "0", "image": ""}], "video_src": "engenn6le06ob08re3vid01"}, "type": "video"}], "_data": [], "type": "video", "template_override": 1}]}]}